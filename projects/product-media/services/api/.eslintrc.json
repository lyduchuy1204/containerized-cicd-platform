{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "tsconfig.json",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "boundaries"],
  "extends": ["plugin:@typescript-eslint/recommended"],
  "ignorePatterns": ["dist", "node_modules", "jest.config.js"],
  "settings": {
    "import/resolver": {
      "node": { "extensions": [".ts", ".js", ".json"] }
    },
    "boundaries/elements": [
      { "type": "domain", "pattern": "src/domain/**/*", "mode": "file" },
      { "type": "application", "pattern": "src/application/**/*", "mode": "file" },
      { "type": "infrastructure", "pattern": "src/infrastructure/**/*", "mode": "file" },
      { "type": "interface", "pattern": "src/interface/**/*", "mode": "file" },
      { "type": "config", "pattern": "src/config/**/*", "mode": "file" },
      { "type": "migrations", "pattern": "src/migrations/**/*", "mode": "file" },
      { "type": "entrypoint", "pattern": "src/main.ts", "mode": "file" },
      { "type": "composition", "pattern": "src/app.module.ts", "mode": "file" },
      { "type": "tests", "pattern": "test/**/*", "mode": "file" }
    ]
  },
  "rules": {
    "boundaries/no-unknown-files": 2,
    "boundaries/element-types": [
      2,
      {
        "default": "disallow",
        "rules": [
          { "from": ["domain"], "allow": ["domain"] },
          { "from": ["application"], "allow": ["application", "domain", "config"] },
          {
            "from": ["infrastructure"],
            "allow": ["infrastructure", "application", "domain", "config", "migrations"]
          },
          { "from": ["interface"], "allow": ["interface", "application", "domain", "config"] },
          { "from": ["config"], "allow": ["config"] },
          { "from": ["migrations"], "allow": ["migrations"] },
          {
            "from": ["composition"],
            "allow": [
              "application",
              "domain",
              "config",
              "infrastructure",
              "interface",
              "composition"
            ]
          },
          {
            "from": ["entrypoint"],
            "allow": [
              "application",
              "domain",
              "config",
              "infrastructure",
              "interface",
              "composition"
            ]
          },
          {
            "from": ["tests"],
            "allow": [
              "tests",
              "application",
              "domain",
              "config",
              "infrastructure",
              "interface"
            ]
          }
        ]
      }
    ]
  }
}
