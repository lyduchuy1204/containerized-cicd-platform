UPLOADS_DIR=./.data/uploads
SCRATCH_DIR=./.data/scratch
DATABASE_URL=postgresql://mediauser:mediapass@localhost:5432/mediadb
REDIS_URL=redis://localhost:6379
QUEUE_NAME=media-processing
WORKER_CONCURRENCY=1
LEASE_DURATION_SECONDS=120
LEASE_RENEW_INTERVAL_SECONDS=30
MAX_ATTEMPTS=3
TRANSCODE_TIMEOUT_SECONDS=1800
MAX_INPUT_BYTES=524288000
MAX_DURATION_SECONDS=600
FFMPEG_PRESET=ultrafast
FFMPEG_THREADS=0
THUMBNAIL_TIMESTAMP=00:00:01
LOG_LEVEL=info
NODE_ENV=development

