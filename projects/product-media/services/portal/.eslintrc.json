{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "tsconfig.json",
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "plugins": ["@typescript-eslint", "boundaries", "react-hooks"],
  "extends": ["plugin:@typescript-eslint/recommended", "plugin:react-hooks/recommended"],
  "ignorePatterns": ["dist", "node_modules", "vite.config.ts", "test"],
  "settings": {
    "import/resolver": {
      "node": { "extensions": [".ts", ".tsx", ".js", ".json"] }
    },
    "boundaries/elements": [
      { "type": "types", "pattern": "src/types/**/*", "mode": "file" },
      { "type": "lib", "pattern": "src/lib/**/*", "mode": "file" },
      { "type": "api", "pattern": "src/api/**/*", "mode": "file" },
      { "type": "components", "pattern": "src/components/**/*", "mode": "file" },
      { "type": "features", "pattern": "src/features/**/*", "mode": "file" },
      { "type": "pages", "pattern": "src/pages/**/*", "mode": "file" },
      { "type": "shell", "pattern": "src/app.tsx", "mode": "file" },
      { "type": "entrypoint", "pattern": "src/main.tsx", "mode": "file" }
    ]
  },
  "rules": {
    "boundaries/no-unknown-files": 2,
    "boundaries/element-types": [
      2,
      {
        "default": "disallow",
        "rules": [
          { "from": ["types"], "allow": ["types"] },
          { "from": ["lib"], "allow": ["lib", "types"] },
          { "from": ["api"], "allow": ["api", "types"] },
          { "from": ["components"], "allow": ["components", "lib", "types"] },
          { "from": ["features"], "allow": ["features", "api", "components", "lib", "types"] },
          { "from": ["pages"], "allow": ["pages", "features", "components"] },
          { "from": ["shell"], "allow": ["pages"] },
          { "from": ["entrypoint"], "allow": ["shell"] }
        ]
      }
    ]
  }
}
